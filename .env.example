# ==============================================================================
# DODO UNIVERSE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure local values.
# NEVER commit .env or files with real secrets/passwords to version control.
# ==============================================================================

# --- BACKEND SERVER CONFIGURATION ---
SERVERPOD_ENV=development
SERVERPOD_PORT=8080
SERVERPOD_PUBLIC_HOST=localhost
SERVERPOD_PUBLIC_PORT=8080
SERVERPOD_PUBLIC_SCHEME=http

# --- SUPABASE POSTGRESQL DATABASE ---
# In Supabase: Project Settings -> Database -> Connection Parameters
# Note: For IPv4 compatibility on local development, Session Pooler (port 5432 or 6543)
# is recommended if your ISP or local network does not support direct IPv6.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<your-strong-supabase-database-password>
DB_REQUIRE_SSL=true

# --- FRONTEND (FLUTTER) CONFIGURATION ---
# For Web/Desktop local development: http://localhost:8080/
# For Android Emulator: http://10.0.2.2:8080/
# For Physical Device: http://<LAN_IP>:8080/
FLUTTER_SERVER_URL=http://localhost:8080/

