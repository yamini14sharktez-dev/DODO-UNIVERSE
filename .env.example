# Target Environment (development, staging, production)
ENVIRONMENT=development

# Supabase Project Configuration
SUPABASE_URL=https://swivkawtnqymvymjxlpl.supabase.co
# Obtain from Supabase Dashboard -> Project Settings -> API -> anon public key
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Compile-time Flutter build flags example:
# flutter run --dart-define=ENVIRONMENT=development --dart-define=SUPABASE_ANON_KEY=your_key_here
#
# IMPORTANT SECURITY RULES:
# - NEVER put Supabase service_role keys into Flutter.
