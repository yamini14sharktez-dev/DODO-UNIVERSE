# Target Environment (development, staging, production)
ENVIRONMENT=development

# Supabase Project Configuration
SUPABASE_URL=https://swivkawtnqymvymjxlpl.supabase.co
# Obtain from Supabase Dashboard -> Project Settings -> API -> Project API keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=your_legacy_anon_key_here

# Compile-time Flutter build flags examples:
# flutter run --dart-define-from-file=.env
# or
# flutter run --dart-define=ENVIRONMENT=development --dart-define=SUPABASE_PUBLISHABLE_KEY=your_key_here
#
# IMPORTANT SECURITY RULES:
# - NEVER put Supabase service_role keys into Flutter.
# - NEVER put direct PostgreSQL passwords into mobile or frontend code.
